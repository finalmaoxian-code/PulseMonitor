<!--
    ============================================================================
    OverviewPage.axaml —— 运行总览（SYS / 01）

    版式逻辑（仪表控制台）：
        第一行  三个核心读数（CPU / 内存 / 系统盘），各自带迷你趋势与状态
        第二行  左：实时负载双曲线   右：环形仪表 + 量程条
        第三行  系统状态读数网格 + 刻度尺
    ============================================================================
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:PulseMonitor.Controls"
             xmlns:vm="using:PulseMonitor.ViewModels"
             x:Class="PulseMonitor.Views.OverviewPage"
             x:DataType="vm:DashboardViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">

            <!-- ===================== 顶部：三个核心读数 ===================== -->
            <UniformGrid Columns="3">
                <controls:MetricCard Label="CPU LOAD"
                                     Code="SYS-01"
                                     Value="{Binding CpuValueText}"
                                     Unit="%"
                                     Caption="{Binding CpuCaptionText}"
                                     AccentBrush="{DynamicResource BrushAccent}"
                                     Margin="0,0,4,0">
                    <StackPanel Spacing="6">
                        <controls:TrendChart Height="36"
                                             MaxSamples="60"
                                             AutoScale="True"
                                             Values="{Binding CpuHistory.Values}"
                                             LineBrush="{DynamicResource BrushAccent}"
                                             GridBrush="{DynamicResource BrushGridLine}" />
                        <controls:StatusPill HorizontalAlignment="Left"
                                             Text="{Binding CpuStatusText}"
                                             Level="{Binding CpuLevel}" />
                    </StackPanel>
                </controls:MetricCard>

                <controls:MetricCard Label="MEMORY"
                                     Code="SYS-02"
                                     Value="{Binding MemoryValueText}"
                                     Unit="%"
                                     Caption="{Binding MemoryDetailText}"
                                     AccentBrush="{DynamicResource BrushCyan}"
                                     Margin="4,0,4,0">
                    <StackPanel Spacing="6">
                        <controls:TrendChart Height="36"
                                             MaxSamples="60"
                                             AutoScale="True"
                                             Values="{Binding MemoryHistory.Values}"
                                             LineBrush="{DynamicResource BrushCyan}"
                                             GridBrush="{DynamicResource BrushGridLine}" />
                        <controls:StatusPill HorizontalAlignment="Left"
                                             Text="{Binding MemoryStatusText}"
                                             Level="{Binding MemoryLevel}" />
                    </StackPanel>
                </controls:MetricCard>

                <controls:MetricCard Label="SYSTEM DISK"
                                     Code="SYS-03"
                                     Value="{Binding DiskValueText}"
                                     Unit="%"
                                     Caption="{Binding DiskDetailText}"
                                     AccentBrush="{DynamicResource BrushAmber}"
                                     Margin="4,0,0,0">
                    <StackPanel Spacing="8">
                        <controls:MeterBar Margin="0,14,0,0"
                                           BarHeight="6"
                                           Value="{Binding DiskPercent}"
                                           IndicatorBrush="{DynamicResource BrushAmber}" />
                        <controls:StatusPill HorizontalAlignment="Left"
                                             Text="{Binding DiskStatusText}"
                                             AccentBrush="{DynamicResource BrushAmber}" />
                    </StackPanel>
                </controls:MetricCard>
            </UniformGrid>

            <!-- ===================== 中部：曲线 + 仪表 ===================== -->
            <Grid ColumnDefinitions="2*,1*" ColumnSpacing="12">

                <controls:SectionCard Grid.Column="0"
                                      Header="实时负载"
                                      Code="LIVE"
                                      Hint="{Binding SamplingIntervalText, StringFormat='Δ {0}'}"
                                      AccentBrush="{DynamicResource BrushAccent}">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">

                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Text="CPU" Classes="eyebrow" />
                            <controls:StatusPill Grid.Column="2"
                                                 Text="{Binding CpuStatusText}"
                                                 Level="{Binding CpuLevel}" />
                        </Grid>
                        <controls:TrendChart Grid.Row="1"
                                             Height="74"
                                             Values="{Binding CpuHistory.Values}"
                                             Maximum="100"
                                             LineBrush="{DynamicResource BrushAccent}"
                                             GridBrush="{DynamicResource BrushGridLine}" />

                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Text="MEM" Classes="eyebrow" />
                            <controls:StatusPill Grid.Column="2"
                                                 Text="{Binding MemoryStatusText}"
                                                 Level="{Binding MemoryLevel}" />
                        </Grid>
                        <controls:TrendChart Grid.Row="3"
                                             Height="74"
                                             Values="{Binding MemoryHistory.Values}"
                                             Maximum="100"
                                             LineBrush="{DynamicResource BrushCyan}"
                                             GridBrush="{DynamicResource BrushGridLine}" />
                    </Grid>
                </controls:SectionCard>

                <controls:SectionCard Grid.Column="1"
                                      Header="负载仪表"
                                      Code="GAUGE"
                                      AccentBrush="{DynamicResource BrushGreen}">
                    <Grid RowDefinitions="*,Auto" RowSpacing="10">
                        <controls:GaugeMeter Height="146"
                                             Value="{Binding CpuPercent}"
                                             Maximum="100"
                                             TrackThickness="10"
                                             TrackBrush="{DynamicResource BrushGaugeTrack}"
                                             AccentBrush="{DynamicResource BrushAccent}"
                                             CenterText="{Binding CpuPercentText}"
                                             CenterLabel="CPU LOAD"
                                             CenterBrush="{DynamicResource BrushText}" />

                        <StackPanel Grid.Row="1" Spacing="10">
                            <StackPanel Spacing="5">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="CPU" Classes="eyebrow" />
                                    <TextBlock Grid.Column="1" Text="{Binding CpuPercentText}" Classes="numeric" />
                                </Grid>
                                <controls:MeterBar Value="{Binding CpuPercent}"
                                                   Level="{Binding CpuLevel}"
                                                   BarHeight="6" />
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="MEM" Classes="eyebrow" />
                                    <TextBlock Grid.Column="1" Text="{Binding MemoryPercentText}" Classes="numeric" />
                                </Grid>
                                <controls:MeterBar Value="{Binding MemoryPercent}"
                                                   Level="{Binding MemoryLevel}"
                                                   BarHeight="6" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </controls:SectionCard>
            </Grid>

            <!-- ===================== 底部：系统状态 ===================== -->
            <controls:SectionCard Header="系统状态"
                                  Code="TELEMETRY"
                                  Hint="{Binding UpdatedAtText, StringFormat='T {0}'}"
                                  AccentBrush="{DynamicResource BrushGreen}">
                <StackPanel Spacing="8">
                    <UniformGrid Columns="4">
                        <StackPanel Spacing="4">
                            <TextBlock Text="PROCESSES" Classes="eyebrow" />
                            <TextBlock Text="{Binding ProcessCountText}" Classes="numeric" FontSize="17" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="DOWN TOTAL" Classes="eyebrow" />
                            <TextBlock Text="{Binding TotalDownloadedText}" Classes="numeric" FontSize="17" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="UP TOTAL" Classes="eyebrow" />
                            <TextBlock Text="{Binding TotalUploadedText}" Classes="numeric" FontSize="17" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="INTERVAL" Classes="eyebrow" />
                            <TextBlock Text="{Binding SamplingIntervalText}" Classes="numeric" FontSize="17" />
                        </StackPanel>
                    </UniformGrid>

                    <controls:TickRule Height="10"
                                       TickCount="100"
                                       MajorEvery="10"
                                       MinorLength="3"
                                       MajorLength="6"
                                       TickBrush="{DynamicResource BrushGridLineStrong}" />

                    <UniformGrid Columns="3">
                        <StackPanel Spacing="4">
                            <TextBlock Text="COMMIT" Classes="eyebrow" />
                            <TextBlock Text="{Binding MemoryCommitText}" Classes="numeric" FontSize="14" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="SYSTEM CACHE" Classes="eyebrow" />
                            <TextBlock Text="{Binding MemoryCacheText}" Classes="numeric" FontSize="14" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="DATA QUALITY" Classes="eyebrow" />
                            <controls:StatusPill HorizontalAlignment="Left"
                                                 Text="{Binding DataQualityText}"
                                                 Level="{Binding DataQualityLevel}" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </controls:SectionCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
