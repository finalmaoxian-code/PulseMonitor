<!--
    ============================================================================
    ProcessPage.axaml —— 进程明细（PROC / 03）

    表格化排版：表头用丝印标签，行用发丝线分隔，数值列等宽右对齐。
    列表使用 VirtualizingStackPanel，只创建视口内的行容器。
    ============================================================================
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:PulseMonitor.Controls"
             xmlns:vm="using:PulseMonitor.ViewModels"
             x:Class="PulseMonitor.Views.ProcessPage"
             x:DataType="vm:DashboardViewModel">

    <controls:SectionCard Header="进程占用排行"
                          Code="PROC"
                          Hint="{Binding ProcessSummaryText}"
                          AccentBrush="{DynamicResource BrushRose}">
        <Grid RowDefinitions="Auto,Auto,*" Margin="0,-2,0,0">

            <Grid ColumnDefinitions="*,72,90,64,64,14" Margin="0,0,0,7">
                <TextBlock Text="PROCESS / IDENTITY" Classes="eyebrow" />
                <TextBlock Grid.Column="1" Text="CPU"
                           Classes="eyebrow" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="MEM"
                           Classes="eyebrow" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="THR"
                           Classes="eyebrow" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Text="HND"
                           Classes="eyebrow" HorizontalAlignment="Right" />
            </Grid>

            <Rectangle Grid.Row="1" Height="1"
                       Fill="{DynamicResource BrushBorder}" />

            <ListBox Grid.Row="2"
                     Margin="0,6,0,0"
                     Padding="0,0,12,0"
                     ItemsSource="{Binding Processes}"
                     ItemTemplate="{StaticResource ProcessRow}"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectionMode="Single">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- 虚拟化：只生成视口内的行 -->
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}" />
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
                    </Style>
                </ListBox.Styles>
            </ListBox>
        </Grid>
    </controls:SectionCard>
</UserControl>
