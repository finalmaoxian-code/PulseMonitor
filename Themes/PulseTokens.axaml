<!--
    ============================================================================
    PulseTokens.axaml —— 设计令牌（间距 / 圆角 / 字号 / 字距）

    视觉方向：仪表控制台。圆角压到 0–2px，靠发丝线和间距建立秩序，
    字号走「铭牌（大）+ 数据（等宽）+ 标签（小、全大写、宽字距）」三层。
    ============================================================================
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 圆角：工业面板几乎不用圆角，只保留 2px 消毛刺 ===== -->
    <CornerRadius x:Key="RadiusSmall">2</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">2</CornerRadius>
    <CornerRadius x:Key="RadiusCard">2</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">2</CornerRadius>
    <CornerRadius x:Key="RadiusPill">2</CornerRadius>

    <!-- ===== 间距 ===== -->
    <Thickness x:Key="SpacingCard">18,16</Thickness>
    <Thickness x:Key="SpacingCardCompact">14,12</Thickness>
    <Thickness x:Key="SpacingPage">20</Thickness>

    <!-- ===== 字号 ===== -->
    <x:Double x:Key="FontSizeDisplay">40</x:Double>
    <x:Double x:Key="FontSizeTitle">19</x:Double>
    <x:Double x:Key="FontSizeSubtitle">14</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeCaption">11.5</x:Double>
    <x:Double x:Key="FontSizeMicro">10</x:Double>

    <!-- ===== 字距：小号标签拉开字距，像仪器面板上的丝印 ===== -->
    <x:Double x:Key="LetterSpacingLabel">2.0</x:Double>
    <x:Double x:Key="LetterSpacingData">0.2</x:Double>

    <!-- ===== 动效时长 ===== -->
    <x:Double x:Key="MotionFast">120</x:Double>
    <x:Double x:Key="MotionNormal">200</x:Double>
    <x:Double x:Key="MotionSlow">320</x:Double>

</ResourceDictionary>
