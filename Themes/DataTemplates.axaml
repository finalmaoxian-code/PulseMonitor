<!--
    ============================================================================
    DataTemplates.axaml —— 可复用的数据模板
    ============================================================================
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:PulseMonitor.ViewModels">

    <DataTemplate x:Key="ProcessRow" x:DataType="vm:ProcessRowViewModel">
        <Border Padding="0,7"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,72,90,64,64,14">
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="{Binding Name}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding ExecutablePath}"
                               Foreground="{DynamicResource BrushText}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding PidText}"
                                   FontFamily="{DynamicResource MonoFontFamily}"
                                   FontSize="10"
                                   Foreground="{DynamicResource BrushTextMuted}" />
                        <TextBlock Text="{Binding IdentityText}"
                                   FontFamily="{DynamicResource MonoFontFamily}"
                                   FontSize="10"
                                   Foreground="{DynamicResource BrushTextMuted}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding CpuText}"
                           Classes="numeric"
                           ToolTip.Tip="{Binding CpuTooltip}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushTextSecondary}" />

                <TextBlock Grid.Column="2"
                           Text="{Binding MemoryText}"
                           Classes="numeric"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushTextSecondary}" />

                <TextBlock Grid.Column="3"
                           Text="{Binding ThreadsText}"
                           Classes="numeric"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushTextMuted}" />

                <TextBlock Grid.Column="4"
                           Text="{Binding HandlesText}"
                           Classes="numeric"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushTextMuted}" />
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
