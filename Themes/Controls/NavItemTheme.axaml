<!--
    ============================================================================
    NavItemTheme.axaml —— 侧边栏导航项

    工业风做法：不是胶囊按钮，而是一行「通道选择器」：
        01  ┃  总览
            ┃  CPU / 内存 / 磁盘
    选中态靠左侧 2px 信号色立条 + 文字提亮表达，不做背景填充与圆角。
    ============================================================================
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:PulseMonitor.Controls">

    <ControlTheme x:Key="{x:Type controls:NavItem}" TargetType="controls:NavItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />

        <Setter Property="Template">
            <ControlTemplate>
                <!--
                    注意：这里**不**用 TemplateBinding Background，
                    因为 Fluent 基础主题里还有针对 ListBoxItem 的 :pointerover 样式，
                    会把 Background 改成它自己的高亮色并与我们的样式叠加。
                -->
                <Border Name="PART_Bg"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="2,0,0,0"
                        CornerRadius="0"
                        Padding="12,9"
                        Margin="0,1">
                    <Grid ColumnDefinitions="Auto,Auto,*">

                        <!-- 通道编号 -->
                        <TextBlock Name="PART_Code"
                                   Text="{TemplateBinding Code}"
                                   FontFamily="{DynamicResource MonoFontFamily}"
                                   FontSize="{DynamicResource FontSizeMicro}"
                                   FontFeatures="tnum"
                                   Width="18"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushTextMuted}" />

                        <!-- 图标 -->
                        <TextBlock Name="PART_Glyph"
                                   Grid.Column="1"
                                   Text="{TemplateBinding Glyph}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Width="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushTextMuted}" />

                        <!-- 主标题 + 副标题 -->
                        <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Name="PART_Text"
                                       Text="{TemplateBinding Text}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource BrushTextSecondary}" />
                            <TextBlock Name="PART_Subtitle"
                                       Text="{TemplateBinding Subtitle}"
                                       Margin="0,3,0,0"
                                       FontSize="{DynamicResource FontSizeMicro}"
                                       Foreground="{DynamicResource BrushTextMuted}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- 悬停：仅文字提亮 -->
        <Style Selector="^:pointerover /template/ TextBlock#PART_Text">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
        </Style>
        <Style Selector="^:pointerover /template/ TextBlock#PART_Glyph">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        </Style>

        <!-- 选中：左侧信号色立条 + 文字提亮 + 编号变强调色 -->
        <Style Selector="^:selected /template/ Border#PART_Bg">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        </Style>
        <Style Selector="^:selected /template/ TextBlock#PART_Text">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="^:selected /template/ TextBlock#PART_Subtitle">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        </Style>
        <Style Selector="^:selected /template/ TextBlock#PART_Glyph">
            <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
        </Style>
        <Style Selector="^:selected /template/ TextBlock#PART_Code">
            <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
