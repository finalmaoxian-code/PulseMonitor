<!--
    ============================================================================
    StatusPillTheme.axaml —— 状态标记

    工业风做法：不再是圆角胶囊，而是一枚「读数标签」：
        ▪  轻载
    方形指示灯 + 小号等宽文字，1px 方框，零圆角。
    Pulse=True 时才播放呼吸动画（默认关闭，避免长期重绘）。
    ============================================================================
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:PulseMonitor.Controls">

    <ControlTheme x:Key="{x:Type controls:StatusPill}" TargetType="controls:StatusPill">
        <Setter Property="AccentBrush" Value="{DynamicResource BrushAccent}" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Padding="7,3,9,3">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <!-- 方形指示灯：外层光晕 + 内层实心 -->
                        <Panel Width="6" Height="6" VerticalAlignment="Center">
                            <Rectangle Name="Halo"
                                       Width="6" Height="6"
                                       Opacity="0.4"
                                       Fill="{TemplateBinding AccentBrush}" />
                            <Rectangle Width="3" Height="3"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Fill="{TemplateBinding AccentBrush}" />
                        </Panel>

                        <TextBlock Text="{TemplateBinding Text}"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   FontFeatures="tnum"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- ===== 语义换色 ===== -->
        <Style Selector="^.calm">
            <Setter Property="AccentBrush" Value="{DynamicResource BrushGreen}" />
        </Style>
        <Style Selector="^.normal">
            <Setter Property="AccentBrush" Value="{DynamicResource BrushAccent}" />
        </Style>
        <Style Selector="^.high">
            <Setter Property="AccentBrush" Value="{DynamicResource BrushAmber}" />
        </Style>
        <Style Selector="^.critical">
            <Setter Property="AccentBrush" Value="{DynamicResource BrushRose}" />
        </Style>

        <!-- 无有效读数时指示灯变暗（静态样式，不引入动画） -->
        <Style Selector="^[IsLive=False] /template/ Rectangle#Halo">
            <Setter Property="Opacity" Value="0.16" />
        </Style>
        <Style Selector="^[IsLive=False]">
            <Setter Property="Opacity" Value="0.72" />
        </Style>

        <!-- Pulse=True 时指示灯呼吸 -->
        <Style Selector="^[Pulse=True] /template/ Rectangle#Halo">
            <Style.Animations>
                <Animation Duration="0:0:2.4" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.45" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.05" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.45" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </ControlTheme>

</ResourceDictionary>
