<!--
    ============================================================================
    MainWindow.axaml —— 主窗口（装配图）

        Window
        ├── 顶栏        标识 / 系统代号 / 最近更新 / 主题     ← 控制台铭牌
        ├── 量程尺      全宽刻度线（标志性元素）
        ├── SidebarView 侧边栏（通道选择）
        └── Carousel    内容区（CrossFade 翻页）

    工业风要点：无圆角、无光斑，全部由发丝线与刻度建立结构。
    ============================================================================
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:PulseMonitor.Controls"
        xmlns:vm="using:PulseMonitor.ViewModels"
        xmlns:views="using:PulseMonitor.Views"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="780"
        x:Class="PulseMonitor.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="PulseMonitor · 系统监控终端"
        Width="1180"
        Height="780"
        MinWidth="940"
        MinHeight="620"
        Background="{DynamicResource BrushWindowBackground}"
        FontFamily="{DynamicResource AppFontFamily}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ============ 顶栏：控制台铭牌 ============ -->
        <Border Grid.Row="0"
                Background="{DynamicResource BrushSidebar}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,0,0,1">

            <Grid ColumnDefinitions="232,*,Auto" Height="60">

                <!-- 品牌区 -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="10"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center">
                    <Border Width="26" Height="26"
                            Background="{DynamicResource BrushAccent}"
                            CornerRadius="0">
                        <TextBlock Text="&#xE9D9;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="#0A0B0C"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="PULSE MONITOR"
                                   FontFamily="{DynamicResource DisplayFontFamily}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   LetterSpacing="2.2" />
                        <TextBlock Text="SYSTEM TELEMETRY"
                                   Classes="mono"
                                   FontSize="9"
                                   LetterSpacing="1.4" />
                    </StackPanel>
                </StackPanel>

                <!-- 当前页标题与状态 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="14"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center">
                    <Rectangle Width="1" Height="26"
                               Fill="{DynamicResource BrushBorder}" />
                    <TextBlock Text="{Binding PageTitle}"
                               FontFamily="{DynamicResource DisplayFontFamily}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               LetterSpacing="0.8"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PageCode}"
                               Classes="mono"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- 右侧：更新时间 + 主题 -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="12"
                            Margin="0,0,18,0"
                            VerticalAlignment="Center">

                    <controls:StatusPill Text="{Binding Dashboard.UpdatedAtText, StringFormat='{}{0}'}"
                                         AccentBrush="{DynamicResource BrushGreen}"
                                         Pulse="True" />

                    <Border Background="Transparent"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="0"
                            Padding="8,3">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <TextBlock Text="LGT"
                                       Classes="mono"
                                       FontSize="9"
                                       LetterSpacing="1"
                                       VerticalAlignment="Center" />
                            <ToggleSwitch IsChecked="False"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="OnThemeSwitchChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 全宽量程尺（标志性元素） ============ -->
        <Border Grid.Row="1"
                Background="{DynamicResource BrushSidebar}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="18,0"
                Height="16">
            <controls:TickRule TickCount="120"
                               MajorEvery="10"
                               MinorLength="3"
                               MajorLength="6"
                               TickBrush="{DynamicResource BrushBorderStrong}"
                               VerticalAlignment="Bottom" />
        </Border>

        <!-- ============ 主体：侧边栏 + 内容 ============ -->
        <Grid Grid.Row="2" ColumnDefinitions="232,*">

            <views:SidebarView Grid.Column="0" />

            <Carousel Grid.Column="1"
                      x:Name="PageHost"
                      Margin="22,20,22,20"
                      IsSwipeEnabled="False"
                      SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}">
                <Carousel.PageTransition>
                    <CrossFade Duration="0:0:0.18" />
                </Carousel.PageTransition>

                <views:OverviewPage DataContext="{Binding #PageHost.DataContext.Dashboard}" />
                <views:NetworkPage DataContext="{Binding #PageHost.DataContext.Dashboard}" />
                <views:ProcessPage DataContext="{Binding #PageHost.DataContext.Dashboard}" />
            </Carousel>
        </Grid>
    </Grid>
</Window>
